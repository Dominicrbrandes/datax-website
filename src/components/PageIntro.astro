---
interface Props {
  eyebrow?: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<section class="intro">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="intro__title">{title}</h1>
    <div class="intro__body">
      <slot />
    </div>
  </div>
</section>

<style>
  /* Flat. The old radial wash is gone; separation comes from the rule and
     the generous space below the headline. */
  .intro {
    padding-block: var(--space-24) var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }

  .intro__title {
    margin-top: var(--space-4);
    font-size: var(--text-3xl);
    font-weight: 300;
  }

  .intro__body {
    margin-top: var(--space-6);
    max-width: 52ch;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .intro__body:empty {
    display: none;
  }
</style>
