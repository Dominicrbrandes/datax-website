---
/**
 * This address used to be the "Let's Connect" page. That page is gone: the
 * social links are in the footer of every page, and "Join us" in the top bar
 * goes to Linktree. This stub sends anyone with an old link or bookmark to the
 * home page instead of a dead end.
 *
 * It also matters for the cPanel deploy, which copies the new files over the
 * old ones and never deletes anything. Without this stub the old page would
 * stay on the server at /connect indefinitely. With it, the old page is
 * overwritten by this redirect.
 */
import { club } from '../config';
import { url } from '../utils/url';

const home = url('/');
const canonical = new URL(home, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${home}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>{club.name}</title>
  </head>
  <body>
    <p><a href={home}>Continue to the {club.name} home page</a></p>
  </body>
</html>
